---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { SITE_CONFIG } from '../config';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---
<header class="site-header">
	<nav>
		<div class="logo">
			<a href={getRelativeLocaleUrl(lang, '')}>{SITE_CONFIG.title}</a>
		</div>
		<div class="links">
			<a href={getRelativeLocaleUrl(lang, '')}>{t('nav.home')}</a>
			<a href={getRelativeLocaleUrl(lang, 'archive')}>{t('nav.archive')}</a>
			<a href={getRelativeLocaleUrl(lang, 'tags')}>{t('nav.tags')}</a>
			<a href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a>
		</div>
	</nav>
</header>


<style>
	.site-header {
		width: var(--site-width);
		padding: 1.5rem 0;
		margin-left: auto;
		margin-right: auto;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	.logo a {
		font-family: var(--font-family-heading);
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--heading-color);
		letter-spacing: -0.02em;
	}
	
	.logo a:hover {
		color: var(--accent);
	}

	.links {
		display: flex;
		gap: 1.5rem;
		/* On mobile this wraps below logo/lang row */
		order: 3;
		width: 100%;
		justify-content: center;
	}

	.links a {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--light);
	}

	.links a:hover {
		color: var(--heading-color);
	}


	/* Desktop: restore three-column flex, no wrapping */
	@media (min-width: 640px) {
		nav {
			flex-wrap: nowrap;
		}

		.links {
			order: unset;
			width: auto;
			justify-content: flex-start;
		}
	}
</style>
